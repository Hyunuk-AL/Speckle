# このファイルを .env にコピーして値を調整してください
#   cp .env.example .env

# Speckle のバージョン (Docker イメージのタグ)。
# "2" にすると常に最新の 2.x を追従する。PoC では再現性のため固定を推奨。
SPECKLE_VERSION=2.31.11

# ブラウザ / Revit コネクタからアクセスする URL。
# 後から変更すると既存データの参照が崩れるため、PoC 中は localhost で固定する。
CANONICAL_URL=http://localhost

# フロントエンドを公開するホスト側ポート
HOST_PORT=80

# セッション署名用シークレット。必ず一意なランダム文字列に変更すること。
# 生成例 (WSL2 / Git Bash):  openssl rand -hex 32
SESSION_SECRET=

# PostgreSQL / MinIO の認証情報 (PoC 中はデフォルトのままでも可)
POSTGRES_PASSWORD=speckle
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ブラウザから MinIO (プレビュー画像等) を参照する URL
S3_PUBLIC_ENDPOINT=http://localhost:9000

# アップロード可能なファイルサイズ上限 (MB)
FILE_SIZE_LIMIT_MB=100
